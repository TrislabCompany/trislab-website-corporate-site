---
// Trislab's logo mark, from the current site (tl-company-webapp,
// components/logo.tsx). Decorative: the wordmark next to it carries the name.
interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <rect x="2" y="2" width="60" height="60" rx="16" fill="#0F172A" stroke="#1E293B" stroke-width="2"></rect>
  <line x1="14" y1="15" x2="50" y2="15" stroke="#E2E8F0" stroke-opacity="0.18" stroke-width="1.4"></line>
  <line x1="14" y1="49" x2="50" y2="49" stroke="#E2E8F0" stroke-opacity="0.18" stroke-width="1.4"></line>
  <path d="M14 20 H34" stroke="#F97316" stroke-width="3.6" stroke-linecap="round"></path>
  <path d="M24 20 V45" stroke="#F97316" stroke-width="3.6" stroke-linecap="round"></path>
  <path d="M38 19 V45" stroke="#E2E8F0" stroke-width="3.6" stroke-linecap="round"></path>
  <path d="M38 45 H51" stroke="#E2E8F0" stroke-width="3.6" stroke-linecap="round"></path>
</svg>
