---
// Shows the Environment the container runs in, read from /config.json in the
// browser. The same image runs in every Environment. Hidden in prod, where
// visitors don't need it.
---

<span class="environment" data-environment>Environment: local</span>

<script>
  import { loadConfig } from "../lib/config";

  const config = await loadConfig();
  const environment = config.PLATFORM_ENVIRONMENT ?? "local";
  document.querySelectorAll("[data-environment]").forEach((element) => {
    if (environment === "prod") element.remove();
    else element.textContent = `Environment: ${environment}`;
  });
</script>
