---
// The sitemap for people: every page of the site in this language, as links.
// Search engines read /sitemap-index.xml instead (astro.config.mjs). It also
// gives visitors a second way to find a page besides the menu (WCAG 2.4.5).
import { languagePaths, localizedPath, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug } from "../../lib/content";
import { sortedItems } from "../../lib/items";
import site from "../../site.config";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const services = await sortedItems("services", lang);
const products = await sortedItems("products", lang);
const legal = [
  { on: site.legalPages.imprint, href: "/imprint", label: t(lang, "legal.imprint") },
  { on: site.legalPages.privacy, href: "/privacy", label: t(lang, "legal.privacy") },
  { on: site.legalPages.accessibility, href: "/accessibility", label: t(lang, "legal.accessibility") },
  { on: site.legalPages.sustainability, href: "/sustainability", label: t(lang, "legal.sustainability") },
].filter((link) => link.on);
---

<BaseLayout title={t(lang, "legal.sitemap")} lang={lang}>
  <h1>{t(lang, "legal.sitemap")}</h1>
  <ul class="sitemap">
    <li><a href={localizedPath(lang)}>{t(lang, "nav.home")}</a></li>
    <li>
      <a href={localizedPath(lang, "/services")}>{t(lang, "nav.services")}</a>
      <ul>
        {services.map((entry) => <li><a href={localizedPath(lang, `/services/${entrySlug(entry)}`)}>{entry.data.title}</a></li>)}
      </ul>
    </li>
    <li>
      <a href={localizedPath(lang, "/products")}>{t(lang, "nav.products")}</a>
      <ul>
        {products.map((entry) => <li><a href={localizedPath(lang, `/products/${entrySlug(entry)}`)}>{entry.data.title}</a></li>)}
      </ul>
    </li>
    <li><a href={localizedPath(lang, "/partners")}>{t(lang, "nav.partners")}</a></li>
    <li><a href={localizedPath(lang, "/about")}>{t(lang, "nav.about")}</a></li>
    <li><a href={localizedPath(lang, "/contact")}>{t(lang, "nav.contact")}</a></li>
    {
      legal.length > 0 && (
        <li>
          {t(lang, "legal.nav")}
          <ul>
            {legal.map(({ href, label }) => (
              <li>
                <a href={localizedPath(lang, href)}>{label}</a>
              </li>
            ))}
          </ul>
        </li>
      )
    }
  </ul>
</BaseLayout>
