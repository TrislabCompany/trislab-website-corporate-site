---
import { render, type CollectionEntry } from "astro:content";
import ContactCta from "../../../components/ContactCta.astro";
import Icon from "../../../components/Icon.astro";
import { localizedPath, t, type Lang } from "../../../i18n";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { itemPaths } from "../../../lib/items";

export function getStaticPaths() {
  return itemPaths("products");
}

const { entry, lang, available } = Astro.props as {
  entry: CollectionEntry<"products">;
  lang: Lang;
  available: Lang[];
};
const { Content } = await render(entry);
const { vendorProduct, features } = entry.data;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} lang={lang} available={available}>
  <article class="prose">
    <p class="eyebrow"><a href={localizedPath(lang, "/products")}>{t(lang, "nav.products")}</a></p>
    <Icon name={entry.data.icon} />
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.summary}</p>
    <Content />
    {
      features.length > 0 && (
        <ul class="checklist">
          {features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      )
    }
    {
      vendorProduct && (
        <dl class="facts">
          <dt>{t(lang, "products.vendorProduct")}</dt>
          <dd>{vendorProduct}</dd>
        </dl>
      )
    }
  </article>
  <ContactCta lang={lang} />
</BaseLayout>
